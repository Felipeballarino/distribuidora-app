{
  "appId": "com.distribuidora.pedidos",
  "productName": "Distribuidora Pedidos",
  "directories": {
    "buildResources": "public",
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "target": "nsis",
    "sign": null,
    "signingHashAlgorithms": null
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Distribuidora Pedidos",
    "deleteAppDataOnUninstall": false
  }
}
