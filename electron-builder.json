{
  "appId": "com.distribuidora.pedidos",
  "productName": "Distribuidora Pedidos",
  "directories": {
    "buildResources": "public",
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "data/**/*",
    "package.json"
  ],
  "win": {
    "target": "nsis",
    "icon": "public/assets/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "installerLanguages": ["es_AR"],
    "language": "3082"
  },
  "extraResources": [
    {
      "from": "data",
      "to": "data"
    }
  ]
}
